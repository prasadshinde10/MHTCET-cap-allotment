# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql://cap_admin:cap_secure_password_dev@postgres:5432/cap_portal

# ============================================================
# Authentication
# ============================================================
# Admin username for login
ADMIN_USERNAME=admin
# Admin email for login
ADMIN_EMAIL=admin@capportal.local
# bcrypt hash of admin password. Generate with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your_password'))"
ADMIN_PASSWORD_HASH=$2b$12$LJ3m4ys3Lk0TSwMCkVc3eOZPnYyLmJqkz1V9xKc3Nkqe3fMVpMKG

# Secret key for JWT signing (min 32 chars, use: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-characters-long

# JWT token expiry in hours
JWT_EXPIRY_HOURS=8

# ============================================================
# Application
# ============================================================
APP_ENV=development
APP_VERSION=1.0.0
PARSER_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173

# ============================================================
# File Storage
# ============================================================
UPLOAD_DIRECTORY=/storage/uploads
MAX_UPLOAD_SIZE_MB=500

# ============================================================
# Rate Limiting
# ============================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
